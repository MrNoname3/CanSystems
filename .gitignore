# Secrets — never commit these, encrypted or not.
*.key
*.keyfile
*.pem
id_rsa*
id_ed25519*
*.kdbx

# Repo-local toolchain, built by scripts/ensure-venv.sh.
.venv/

# Python bytecode: it records the absolute path of its source, a home directory included.
__pycache__/

# Private secret-scan patterns for scripts/check.sh — never commit.
.secret-patterns.local

# Working files: an agent's own temp directory is not on the host's filesystem,
# so anything the user has to see or delete lands here instead.
work/*
!work/.gitkeep

# --- This repository's own ---
# Build output
.pio

# LittleFS image source - transient, generated by ota/otaUpdate.py provisioning
data/

# IDE
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Logs & monitor
platformio-device-monitor-*
logs/device-monitor-*

# Scripts

# Python tool caches (pytest/ruff drop a self-ignoring .gitignore inside too; listed
# here explicitly so it does not depend on the tool version writing it).
.pytest_cache/
.ruff_cache/

# Python tooling venv (project-root, from requirements-dev.txt); the bare pattern also
# catches any stray ota/.venv from before the consolidation.

# OTA
ota/secrets.yaml

# What scripts/secret_check.py must find but no tracked file may name
ota/mosq-ca.crt*

# Locally built web installer
/.web-cache/
