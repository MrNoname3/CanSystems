# clang-tidy configuration — single source of truth for the check list.
#
# Shared by:
#   - `pio check` / the release gate: the check_* environments in platformio.ini point here with
#     `clangtidy: --config-file=.clang-tidy` (cppcheck stays configured in platformio.ini;
#     nothing in the editor runs cppcheck, so there is no parity reason to extract it).
#   - the editor's live clang-tidy (VS Code cpptools), which auto-discovers this file.
#
# Compiler args (-std, -I, -D) are intentionally NOT here: the gate passes
# `--extra-arg=-std=c++17`, the editor uses its own compile settings.
#
# The last block of exclusions holds the checks clang-tidy gained after version 15 that report on
# this code; each stays off until it has been gone through on its own.
Checks: >
  clang-analyzer-*,
  readability-*,
  performance-*,
  bugprone-*,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-avoid-c-arrays,
  -readability-magic-numbers,
  -readability-identifier-length,
  -bugprone-easily-swappable-parameters,
  -bugprone-branch-clone,
  -modernize-deprecated-headers,
  -modernize-use-auto,
  -readability-convert-member-functions-to-static,
  -readability-static-accessed-through-instance,
  -performance-no-int-to-ptr,
  -readability-use-concise-preprocessor-directives,
  -readability-redundant-inline-specifier,
  -readability-math-missing-parentheses,
  -readability-use-std-min-max,
  -readability-redundant-casting,
  -readability-avoid-nested-conditional-operator,
  -performance-enum-size,
  -bugprone-switch-missing-default-case,
  -modernize-type-traits,
  -clang-analyzer-core.FixedAddressDereference
# avr-libc's PSTR() declares a __pstr__ at every use.
CheckOptions:
  bugprone-reserved-identifier.AllowedIdentifiers: '__pstr__'
