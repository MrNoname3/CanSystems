# clang-tidy configuration — single source of truth for the check list.
#
# Shared by:
#   - the release gate: scripts/analysis_check.py passes it with --config-file.
#   - the editor's live clang-tidy (VS Code cpptools), which auto-discovers this file.
#
# Compiler args (-std, -I, -D) are intentionally NOT here: the gate takes each environment's from
# its compilation database, the editor uses its own compile settings.
#
# Exclusions that need a reason:
#   readability-use-std-min-max - the AVR toolchain has no C++ standard library, and much of lib/
#     builds for AVR.
#   clang-analyzer-core.FixedAddressDereference - every memory-mapped register access is one.
#   readability-math-missing-parentheses - it wants parentheses around every a + b * c, and it
#     reports inside avr-libc's UINT16_MAX and UINT32_MAX, which it has no option to skip.
#   readability-redundant-casting - a cast one target needs looks redundant on another: uint16_t is
#     unsigned int on AVR and unsigned short on the ESPs, and analogRead() and resetWatchdog()
#     return different types per platform.
#   bugprone-throwing-static-initialization - the drivers and services are file-scope objects by
#     design, and an allocation that fails before setup() has nothing to recover to.
Checks: >
  clang-analyzer-*,
  readability-*,
  performance-*,
  bugprone-*,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-avoid-c-arrays,
  -readability-magic-numbers,
  -readability-identifier-length,
  -bugprone-easily-swappable-parameters,
  -bugprone-branch-clone,
  -modernize-deprecated-headers,
  -modernize-use-auto,
  -readability-convert-member-functions-to-static,
  -readability-static-accessed-through-instance,
  -performance-no-int-to-ptr,
  -readability-use-std-min-max,
  -clang-analyzer-core.FixedAddressDereference,
  -readability-math-missing-parentheses,
  -readability-redundant-casting,
  -bugprone-throwing-static-initialization
# avr-libc's PSTR() declares a __pstr__ at every use. The CAN command enums are as wide as the
# command field they travel in, whatever values they hold today. Register and bit-mask macros spell
# their masks as plain int literals, which signed-bitwise would otherwise report at every use.
# A default member initialiser is written as an assignment, as the rest of the code writes them.
CheckOptions:
  bugprone-reserved-identifier.AllowedIdentifiers: '__pstr__'
  bugprone-signed-bitwise.IgnorePositiveIntegerLiterals: true
  modernize-use-default-member-init.UseAssignment: true
  performance-enum-size.EnumIgnoreList: '::CanCmd;::AlertCmd;::IrrigationCmd'
